model Review {
  id           String   @id @default(uuid())
  productId    String
  userId       String
  rating       Int // 1 to 5
  title        String?
  comment      String?  @db.Text
  isVerified   Boolean  @default(false)
  helpfulVotes Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  BROWSER
  WEBHOOK
  SLACK
  DISCORD
}

enum NotificationCategory {
  ORDER
  PAYMENT
  SHIPPING
  AUTH
  PROMOTION
  SYSTEM
  SECURITY
  MARKETING
  AI
  MEDIA
  ANALYTICS
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  RETRYING
  CANCELLED
  DEAD
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id               String               @id @default(uuid())
  organizationId   String?
  websiteId        String?
  type             String               // e.g. "ORDER_CONFIRMED", "WELCOME"
  category         NotificationCategory @default(ORDER)
  channel          NotificationChannel  @default(EMAIL)
  priority         NotificationPriority @default(NORMAL)
  recipientId      String?
  recipientContact String?              // email / phone number / webhook URL
  status           NotificationStatus   @default(PENDING)
  templateId       String?
  payload          String?              @db.Text // JSON payload
  title            String?
  body             String?              @db.Text
  isRead           Boolean              @default(false)
  scheduledAt      DateTime?
  sentAt           DateTime?
  readAt           DateTime?
  failedAt         DateTime?
  expiresAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  recipient        User?                 @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  template         NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  actions          NotificationAction[]
  jobs             NotificationJob[]
  logs             NotificationLog[]

  @@index([recipientId])
  @@index([status])
  @@index([category])
  @@index([organizationId, websiteId])
}

model NotificationAction {
  id             String       @id @default(uuid())
  notificationId String
  label          String       // e.g. "View Order", "Track Package"
  url            String       // e.g. "/account/orders/123"
  type           String       @default("PRIMARY") // "PRIMARY", "SECONDARY", "LINK"
  createdAt      DateTime     @default(now())

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
}

model NotificationJob {
  id             String             @id @default(uuid())
  notificationId String
  attempts       Int                @default(0)
  maxRetries     Int                @default(3)
  lastError      String?            @db.Text
  nextAttemptAt  DateTime           @default(now())
  status         NotificationStatus @default(PENDING)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  notification   Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([status, nextAttemptAt])
}

model NotificationLog {
  id             String               @id @default(uuid())
  notificationId String?
  recipient      String
  provider       String               // "Resend", "SMTP", "Twilio", "MetaAPI", "FCM", "MockProvider"
  channel        NotificationChannel
  templateId     String?
  latencyMs      Int                  @default(0)
  status         NotificationStatus   @default(SENT)
  response       String?              @db.Text // Raw provider response JSON
  retries        Int                  @default(0)
  createdAt      DateTime             @default(now())

  notification   Notification?        @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  template       NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([notificationId])
}

model NotificationTemplate {
  id             String               @id @default(uuid())
  organizationId String?
  websiteId      String?
  name           String
  event          String               // e.g. "OrderCreated", "PasswordReset"
  channel        NotificationChannel  @default(EMAIL)
  category       NotificationCategory @default(ORDER)
  subject        String?
  html           String?              @db.Text
  text           String?              @db.Text
  variables      String?              @db.Text // JSON array of allowed variable names
  currentVersion Int                  @default(1)
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  versions       NotificationTemplateVersion[]
  notifications  Notification[]
  logs           NotificationLog[]

  @@unique([event, channel])
  @@index([event])
}

model NotificationTemplateVersion {
  id          String               @id @default(uuid())
  templateId  String
  version     Int
  subject     String?
  html        String?              @db.Text
  text        String?              @db.Text
  variables   String?              @db.Text // JSON array
  createdById String?
  createdAt   DateTime             @default(now())

  template    NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
}

model NotificationSetting {
  id        String               @id @default(uuid())
  userId    String
  category  NotificationCategory
  channel   NotificationChannel
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, channel])
}

model PushDevice {
  id           String   @id @default(uuid())
  userId       String
  deviceToken  String   @unique
  platform     String   @default("WEB") // "WEB", "IOS", "ANDROID"
  browser      String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WebhookSubscription {
  id             String   @id @default(uuid())
  organizationId String?
  websiteId      String?
  targetUrl      String
  secret         String   // HMAC signing secret
  events         String   @db.Text // JSON array of event names e.g. ["OrderCreated", "OrderPaid"]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, websiteId])
}

model SearchHistory {
  id               String   @id @default(uuid())
  userId           String?
  query            String
  resultCount      Int      @default(0)
  clickedProductId String?
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([query])
}

model PopularSearch {
  id          String   @id @default(uuid())
  query       String   @unique
  searchCount Int      @default(1)
  updatedAt   DateTime @updatedAt
}

model RecentlyViewed {
  id        String   @id @default(uuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Setting {
  key         String   @id
  value       String   @db.Text
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String // "CREATE", "UPDATE", "DELETE"
  changes    String   @db.Text // JSON payload of changes
  userId     String? // The admin/user who made the change
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

