generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// 1. GLOBAL MEDIA LIBRARY
// ============================================================================

enum MediaVisibility {
  PUBLIC
  PRIVATE
  MERCHANT_ONLY
  SYSTEM
}

enum MediaStatus {
  ACTIVE
  ARCHIVED
  PROCESSING
}

enum AssetType {
  IMAGE
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  MODEL_3D
  FONT
  SVG
  LOTTIE
  ICON
  AI_ASSET
  OTHER
}

model Media {
  id              String          @id @default(uuid())
  assetType       AssetType       @default(IMAGE)
  assetKey        String?         // CDN / Storage Key
  derivedFromId   String?         // Relational asset derivation (e.g. PSD -> PNG -> WebP)
  filename        String
  originalName    String
  mimeType        String
  extension       String?
  size            Int // bytes
  fileHash        String? // SHA-256 hash for duplicate detection
  width           Int?
  height          Int?
  duration        Float? // for video/audio in seconds
  aspectRatio     Float?
  storageProvider String // "LOCAL", "AWS_S3", "CLOUDINARY", "R2"
  path            String          @unique
  publicUrl       String?         @db.Text
  alt             String?
  caption         String?         @db.Text
  dominantColor   String? // Hex string e.g. #FF5733
  blurHash        String? // Base64 or blurhash string
  uploadedById    String?
  focusX          Float           @default(0.5) // Focal point X (0.0 to 1.0)
  focusY          Float           @default(0.5) // Focal point Y (0.0 to 1.0)
  visibility      MediaVisibility @default(PUBLIC)
  status          MediaStatus     @default(ACTIVE)
  usageCount      Int             @default(0) // Cached reference counter

  // Expanded AI Metadata (Sprint 10 Ready)
  aiCaption       String?         @db.Text
  aiTags          String?         @db.Text // JSON Array
  ocrText         String?         @db.Text
  labels          String?         @db.Text // JSON
  scene           String?
  objects         String?         @db.Text
  faces           String?         @db.Text
  brand           String?
  keywords        String?         @db.Text
  nsfwScore       Float?
  qualityScore    Float?
  colorPalette    String?         @db.Text
  embeddingVector String?         @db.Text
  similarityHash  String?

  folderId        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  folder          MediaFolder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy      User?                   @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  derivedFrom     Media?                  @relation("AssetDerivation", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derivedAssets   Media[]                 @relation("AssetDerivation")
  assetMetadata   AssetMetadata[]

  variants        MediaVariant[]
  versions        MediaVersion[]
  usages          MediaUsage[]
  tags            MediaTagMapping[]
  collections     MediaCollectionMapping[]

  productImages ProductImage[]
  banners       WebsiteBanner[]
  brands        Brand[]
  seoOgImages   Seo[]           @relation("SeoOgImage")
  seoFavicons   Seo[]           @relation("SeoFavicon")
  userAvatars   User[]          @relation("UserAvatar")
  mediaReferences MediaReference[]

  categoryIcons      Category[]    @relation("CategoryIcon")
  categoryBanners    Category[]    @relation("CategoryBanner")
  categoryThumbnails Category[]    @relation("CategoryThumbnail")
  productSeoImages   ProductSeo[]  @relation("ProductSeoImage")
  categorySeoImages  CategorySeo[] @relation("CategorySeoImage")
  brandSeoImages     BrandSeo[]    @relation("BrandSeoImage")

  @@index([folderId])
  @@index([fileHash])
  @@index([mimeType])
  @@index([status])
}

model MediaFolder {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children MediaFolder[] @relation("FolderHierarchy")
  media    Media[]
}

model MediaCollection {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items MediaCollectionMapping[]
}

model MediaCollectionMapping {
  mediaId      String
  collectionId String
  createdAt    DateTime @default(now())

  media      Media           @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  collection MediaCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([mediaId, collectionId])
}

model MediaVersion {
  id            String   @id @default(uuid())
  mediaId       String
  versionNumber Int
  fileName      String
  storagePath   String
  publicUrl     String?  @db.Text
  fileHash      String?
  size          Int
  mimeType      String
  createdById   String?
  createdAt     DateTime @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, versionNumber])
}

model MediaVariant {
  id            String   @id @default(uuid())
  mediaId       String
  variantName   String   // "THUMBNAIL", "SMALL", "MEDIUM", "LARGE", "WEBP", "AVIF"
  width         Int?
  height        Int?
  size          Int
  mimeType      String
  storagePath   String
  publicUrl     String?  @db.Text
  createdAt     DateTime @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, variantName])
}

model MediaTag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  media MediaTagMapping[]
}

model MediaTagMapping {
  mediaId   String
  tagId     String
  createdAt DateTime @default(now())

  media Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag   MediaTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId])
}

model MediaUsage {
  id         String   @id @default(uuid())
  mediaId    String
  entityType String   // "Product", "Category", "Brand", "Collection", "User", "WebsiteBanner"
  entityId   String
  field      String?  // "primaryImage", "avatar", "banner", "logo"
  createdAt  DateTime @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
}

model AssetMetadata {
  id        String   @id @default(uuid())
  mediaId   String
  key       String
  value     String   @db.Text
  type      String   @default("STRING") // "STRING", "NUMBER", "BOOLEAN", "JSON"
  createdAt DateTime @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, key])
  @@index([key])
}

// ============================================================================
// 2. USER & AUTHENTICATION
// ============================================================================

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  passwordHash        String?
  firstName           String
  lastName            String
  phone               String?
  dob                 DateTime?
  gender              Gender?
  avatarId            String?
  uploadedMedia       Media[]                    @relation("MediaUploader")
  language            String     @default("en")
  currency            String     @default("USD")
  theme               String     @default("system")
  savedPreferences    String?    @db.Text
  notificationPrefs   String?    @db.Text
  role                Role       @default(CUSTOMER)
  status              UserStatus @default(PENDING_VERIFICATION)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  referralCode        String?    @unique
  referredByCode      String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  avatar         Media?                  @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  addresses      Address[]
  orders         Order[]
  cart           Cart?
  wishlist       Wishlist?
  wallet         Wallet?
  loyaltyAccount LoyaltyAccount?
  reviews               Review[]
  notifications         Notification[]          @relation("NotificationRecipient")
  notificationSettings  NotificationSetting[]
  pushDevices           PushDevice[]
  recentlyViewed        RecentlyViewed[]
  searchHistory         SearchHistory[]
  couponUsages          CouponUsage[]
  sessions              UserSession[]
  tokens                Token[]
  identities            UserIdentity[]
  referralsSent         Referral[]              @relation("Referrer")
  referralsReceived     Referral?               @relation("Referee")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
  GITHUB
  MICROSOFT
  FACEBOOK
}

model UserIdentity {
  id             String       @id @default(uuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model UserSession {
  id             String    @id @default(uuid())
  userId         String
  token          String    @unique
  deviceName     String?
  browser        String?
  browserVersion String?
  os             String?
  ip             String?
  country        String?
  city           String?
  userAgent      String?
  expiresAt      DateTime
  lastActivity   DateTime  @default(now())
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Token {
  id        String    @id @default(uuid())
  userId    String
  type      TokenType
  hash      String    @unique
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_OTP
}

model Address {
  id                   String      @id @default(uuid())
  userId               String
  fullName             String
  phone                String
  company              String?
  label                String? // "Home", "Work"
  street               String
  landmark             String?
  city                 String
  state                String
  postalCode           String
  country              String
  addressType          AddressType @default(HOME)
  deliveryInstructions String?     @db.Text
  isBilling            Boolean     @default(false)
  isShipping           Boolean     @default(true)
  isDefault            Boolean     @default(false)
  latitude             Float?
  longitude            Float?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}

// ============================================================================
// 3. PRODUCT & CATALOG DOMAIN
// ============================================================================

model Category {
  id               String    @id @default(uuid())
  name             String
  slug             String    @unique
  description      String?   @db.Text
  parentId         String?
  iconMediaId      String?
  bannerMediaId    String?
  thumbnailMediaId String?
  isActive         Boolean   @default(true)
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  icon      Media? @relation("CategoryIcon", fields: [iconMediaId], references: [id], onDelete: SetNull)
  banner    Media? @relation("CategoryBanner", fields: [bannerMediaId], references: [id], onDelete: SetNull)
  thumbnail Media? @relation("CategoryThumbnail", fields: [thumbnailMediaId], references: [id], onDelete: SetNull)

  parent   Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]   @relation("CategoryHierarchy")
  products Product[]
  seo      CategorySeo?

  @@index([parentId])
}

model Brand {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  mediaId     String?
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  media    Media?    @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  products Product[]
  seo      BrandSeo?
}

model Collection {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  isAutomatic Boolean  @default(false)
  rules       String?  @db.Text // JSON array of rules for automatic collections
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
  DISCONTINUED
}

enum ProductVisibility {
  PUBLIC
  HIDDEN
  SCHEDULED
}

model Product {
  id               String            @id @default(uuid())
  brandId          String?
  categoryId       String
  name             String
  slug             String            @unique
  shortDescription String?           @db.Text
  longDescription  String            @db.Text
  status           ProductStatus     @default(DRAFT)
  visibility       ProductVisibility @default(PUBLIC)
  ratingAverage    Float             @default(0)
  reviewCount      Int               @default(0)
  viewCount        Int               @default(0)
  salesCount       Int               @default(0)
  wishlistCount    Int               @default(0)
  favoriteCount    Int               @default(0)
  hsnCode          String?
  gstRate          Decimal?          @db.Decimal(5, 2)
  taxClass         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  brand             Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category          Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants          ProductVariant[]
  images            ProductImage[]
  reviews           Review[]
  collections       CollectionProduct[]
  productAttributes ProductAttribute[]
  specifications    ProductSpecification[]
  tags              ProductTag[]
  seo               ProductSeo?
  slugHistory       ProductSlugHistory[]

  @@index([categoryId])
  @@index([brandId])
  @@index([categoryId, status])
  @@index([status, deletedAt])
}

model ProductSlugHistory {
  id        String   @id @default(uuid())
  productId String
  oldSlug   String   @unique
  newSlug   String
  redirect  Boolean  @default(true)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSeo {
  id          String   @id @default(uuid())
  productId   String   @unique
  title       String?
  description String?  @db.Text
  canonical   String?
  keywords    String?  @db.Text
  ogImageId   String?
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  ogImage Media?  @relation("ProductSeoImage", fields: [ogImageId], references: [id], onDelete: SetNull)
}

model CategorySeo {
  id          String  @id @default(uuid())
  categoryId  String  @unique
  title       String?
  description String? @db.Text
  canonical   String?
  ogImageId   String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  ogImage  Media?   @relation("CategorySeoImage", fields: [ogImageId], references: [id], onDelete: SetNull)
}

model BrandSeo {
  id          String  @id @default(uuid())
  brandId     String  @unique
  title       String?
  description String? @db.Text
  canonical   String?
  ogImageId   String?

  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  ogImage Media? @relation("BrandSeoImage", fields: [ogImageId], references: [id], onDelete: SetNull)
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  mediaId   String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  type      String? // "thumbnail", "gallery", "hero"
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([productId])
}

// ============================================================================
// 4. ATTRIBUTES, SPECIFICATIONS & FILTERING
// ============================================================================

model Attribute {
  id           String   @id @default(uuid())
  name         String   @unique
  type         String   @default("text") // "color_hex", "text", "dropdown"
  isFilterable Boolean  @default(true)
  createdAt    DateTime @default(now())

  values   AttributeValue[]
  products ProductAttribute[]
}

model AttributeValue {
  id          String  @id @default(uuid())
  attributeId String
  value       String
  meta        String? // "#FF0000"
  sortOrder   Int     @default(0)

  attribute Attribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants  VariantAttribute[]
}

model ProductAttribute {
  productId   String
  attributeId String

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([productId, attributeId])
}

model ProductVariant {
  id        String    @id @default(uuid())
  productId String
  sku       String    @unique
  barcode   String?   @unique
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product    Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  pricing    ProductPrice?
  inventory  Inventory?
  attributes VariantAttribute[]
  orderItems OrderItem[]
  cartItems  CartItem[]
}

model ProductPrice {
  id               String    @id @default(uuid())
  productVariantId String    @unique
  mrp              Decimal   @db.Decimal(10, 2)
  sellingPrice     Decimal   @db.Decimal(10, 2)
  costPrice        Decimal?  @db.Decimal(10, 2)
  currency         String    @default("USD")
  tax              Decimal   @default(0.00) @db.Decimal(5, 2)
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
}

model VariantAttribute {
  variantId        String
  attributeValueId String

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
}

model SpecificationGroup {
  id        String   @id @default(uuid())
  name      String // "Display", "Battery"
  createdAt DateTime @default(now())

  specs Specification[]
}

model Specification {
  id        String   @id @default(uuid())
  groupId   String
  name      String // "Resolution", "Capacity"
  createdAt DateTime @default(now())

  group        SpecificationGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  productSpecs ProductSpecification[]
}

model ProductSpecification {
  productId String
  specId    String
  value     String // "1080p", "5000mAh"

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  spec    Specification @relation(fields: [specId], references: [id], onDelete: Cascade)

  @@id([productId, specId])
}

// ============================================================================
// 5. INVENTORY DOMAIN
// ============================================================================

model Inventory {
  id                String   @id @default(uuid())
  variantId         String   @unique
  quantityAvailable Int      @default(0)
  quantityReserved  Int      @default(0)
  lowStockThreshold Int      @default(5)
  status            String   @default("IN_STOCK")
  warehouseId       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  warehouse         Warehouse? @relation("WarehouseInventory", fields: [warehouseId], references: [id], onDelete: SetNull)

  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]
}

model InventoryMovement {
  id          String   @id @default(uuid())
  inventoryId String
  quantity    Int
  type        String // "PURCHASE", "SALE", "RETURN", "RESERVATION", "ADJUSTMENT"
  referenceId String?
  notes       String?
  createdAt   DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
}

// ============================================================================
// 6. CHECKOUT: CART, ORDERS, SHIPPING & RETURNS
// ============================================================================

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int      @default(1)
  isSaved   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

// ═══════════════════════════════════════════════
//  WALLET
// ═══════════════════════════════════════════════

enum HoldStatus {
  PENDING    // reserved, balance locked
  FINALIZED  // converted to a debit transaction
  RELEASED   // payment failed or session expired — balance returned
}

enum WalletTxType {
  TOPUP       // customer adds money via Razorpay (webhook-verified)
  PURCHASE    // finalized debit when hold is converted after payment success
  REFUND      // refund for the wallet-funded portion of a cancelled/returned order
  ADJUSTMENT  // admin manual credit or debit — always a NEW row, never edit existing
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  holds        WalletHold[]
}

model WalletTransaction {
  id          String       @id @default(uuid())
  walletId    String
  type        WalletTxType
  amount      Decimal      @db.Decimal(12, 2) // positive = credit, negative = debit
  balance     Decimal      @db.Decimal(12, 2) // running balance AFTER this transaction
  description String?
  orderId     String?
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentId   String?      // Razorpay paymentId — used for TOPUP idempotency
  holdId      String?      // WalletHold that was finalized into this transaction
  createdAt   DateTime     @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([orderId])
  @@index([paymentId])
  @@unique([walletId, paymentId], name: "unique_wallet_topup")
  @@unique([walletId, orderId, type], name: "unique_wallet_order_debit")
}

// Reservation model — prevents concurrent-checkout race conditions
model WalletHold {
  id        String     @id @default(uuid())
  walletId  String
  orderId   String?    // populated after order is created
  sessionId String     @unique // CheckoutSession.id
  amount    Decimal    @db.Decimal(12, 2)
  status    HoldStatus @default(PENDING)
  expiresAt DateTime   // background job releases holds past this time
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, status])
  @@index([sessionId])
  @@index([expiresAt, status])
}

// ═══════════════════════════════════════════════
//  LOYALTY POINTS
// ═══════════════════════════════════════════════

enum LoyaltyTxType {
  EARN          // points credited after order delivered (idempotent per orderId)
  REDEEM        // points debited; finalized from a LoyaltyHold
  ADJUSTMENT    // admin manual correction — new offsetting row, never edit
  WELCOME_BONUS // bonus awarded on new user registration/first login
  REFERRAL      // bonus awarded for referring friends or signing up via referral
}

enum ReferralStatus {
  PENDING_FIRST_ORDER
  COMPLETED
  EXPIRED
}

model LoyaltyAccount {
  id               String @id @default(uuid())
  userId           String @unique
  points               Int      @default(0) // current redeemable balance
  lifetimeEarned       Int      @default(0)
  lifetimeRedeemed     Int      @default(0)
  welcomeBonusClaimed  Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]
  holds        LoyaltyHold[]
}

model LoyaltyTransaction {
  id               String        @id @default(uuid())
  loyaltyAccountId String
  type             LoyaltyTxType
  points           Int           // positive = earn/add, negative = redeem/deduct
  pointsBalance    Int           // snapshot AFTER this transaction
  monetaryValue    Decimal?      @db.Decimal(12, 2) // ₹ value at time of transaction
  description      String?
  orderId          String?
  order            Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  holdId           String?       // LoyaltyHold that was finalized
  adminUserId      String?
  referralId       String?
  referral         Referral?     @relation(fields: [referralId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())

  account LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)

  @@index([loyaltyAccountId, createdAt])
  @@index([orderId])
  // Idempotency: one EARN per order, one REDEEM per order
  @@unique([loyaltyAccountId, orderId, type], name: "unique_loyalty_order_tx")
}

// Reservation model for loyalty — same pattern as WalletHold
model LoyaltyHold {
  id               String     @id @default(uuid())
  loyaltyAccountId String
  orderId          String?
  sessionId        String     @unique
  points           Int
  monetaryValue    Decimal    @db.Decimal(12, 2)
  status           HoldStatus @default(PENDING)
  expiresAt        DateTime
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  account LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)

  @@index([loyaltyAccountId, status])
  @@index([sessionId])
  @@index([expiresAt, status])
}

model Referral {
  id             String         @id @default(uuid())
  referrerId     String
  refereeId      String         @unique
  code           String
  status         ReferralStatus @default(PENDING_FIRST_ORDER)
  referrerPoints Int            @default(100)
  refereePoints  Int            @default(50)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  referrer     User                 @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee      User                 @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@index([referrerId])
  @@index([code])
}


model ShippingProvider {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zones     ShippingZone[]
}

model ShippingZone {
  id                 String  @id @default(uuid())
  shippingProviderId String?
  name               String
  countries          String  @db.Text // JSON ["US", "CA"]
  isActive           Boolean @default(true)

  provider ShippingProvider? @relation(fields: [shippingProviderId], references: [id], onDelete: SetNull)
  rates    ShippingRate[]
  states   ShippingZoneState[]
}

model ShippingRate {
  id         String   @id @default(uuid())
  zoneId     String
  methodName String // "Express"
  cost       Decimal  @db.Decimal(10, 2)
  minOrder   Decimal? @db.Decimal(10, 2)
  maxOrder   Decimal? @db.Decimal(10, 2)
  estDays    String // "3-5 Business Days"
  isActive   Boolean  @default(true)

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  EXPIRED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethodType {
  UPI
  CARD
  NETBANKING
  WALLET
  COD
  GIFT_CARD
}

enum PaymentEventStatus {
  CREATED
  AUTHORIZED
  FAILED
  SUCCESS
  REFUND_STARTED
  REFUNDED
  WEBHOOK_RECEIVED
}

model CheckoutSession {
  id               String   @id @default(uuid())
  userId           String?
  cartId           String?
  shippingAddress  String?  @db.Text
  billingAddress   String?  @db.Text
  couponCode       String?
  shippingMethod   String?
  subTotal         Decimal  @db.Decimal(10, 2)
  taxTotal         Decimal  @db.Decimal(10, 2)
  shippingTotal    Decimal  @db.Decimal(10, 2)
  discountTotal    Decimal  @db.Decimal(10, 2)
  grandTotal       Decimal  @db.Decimal(10, 2)
  paymentMethodCode String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  order            Order?
}

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique
  userId            String
  checkoutSessionId String?     @unique
  subTotal          Decimal     @db.Decimal(10, 2)
  discountTotal     Decimal     @default(0.00) @db.Decimal(10, 2)
  taxTotal          Decimal     @default(0.00) @db.Decimal(10, 2)
  shippingTotal     Decimal     @default(0.00) @db.Decimal(10, 2)
  grandTotal        Decimal     @db.Decimal(10, 2)
  status            OrderStatus @default(PENDING_PAYMENT)

  // Address Snapshot
  shippingName       String?
  shippingPhone      String?
  shippingEmail      String?
  shippingStreet     String?
  shippingCity       String?
  shippingState      String?
  shippingCountry    String?
  shippingPostalCode String?
  billingAddr        String?   @db.Text
  cgstDecimal        Decimal?  @db.Decimal(10, 2)
  sgstDecimal        Decimal?  @db.Decimal(10, 2)
  igstDecimal        Decimal?  @db.Decimal(10, 2)
  utgstDecimal       Decimal?  @db.Decimal(10, 2)
  gstin              String?
  companyName        String?
  invoiceType        String?   // Maps to InvoiceType enum
  isBusinessOrder    Boolean   @default(false)

  // Coupon Snapshot
  couponCode     String?
  discountType   String?
  discountValue  Decimal? @db.Decimal(10, 2)
  couponDiscount Decimal? @db.Decimal(10, 2)

  // Wallet & Loyalty payment allocation (for refund routing)
  walletAmountUsed    Decimal? @db.Decimal(10, 2)
  pointsRedeemed      Int?
  pointsMonetaryValue Decimal? @db.Decimal(10, 2)

  // Shipping Snapshot
  shippingProvider  String?
  trackingNumber    String?
  estimatedDelivery String?
  shippingCost      Decimal? @db.Decimal(10, 2)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  checkoutSession CheckoutSession?     @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payment         Payment?
  timeline        OrderTimeline[]
  returns         Return[]
  walletTxs       WalletTransaction[]
  loyaltyTxs      LoyaltyTransaction[]

  @@index([userId])
  @@index([status])
}

model OrderTimeline {
  id        String   @id @default(uuid())
  orderId   String
  status    String
  message   String?
  createdBy String?  // "SYSTEM", "ADMIN", "USER", etc.
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  variantId   String?
  productName String
  brandName   String?
  sku         String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  discount    Decimal  @default(0.00) @db.Decimal(10, 2)
  tax         Decimal  @default(0.00) @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Return {
  id        String   @id @default(uuid())
  orderId   String
  reason    String
  status    String   @default("REQUESTED") // "REQUESTED", "APPROVED", "REFUNDED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order  Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items  ReturnItem[]
  refund Refund?
}

model ReturnItem {
  id          String @id @default(uuid())
  returnId    String
  orderItemId String
  quantity    Int

  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

model Refund {
  id                String         @id @default(uuid())
  returnId          String?        @unique
  paymentId         String?
  amount            Decimal        @db.Decimal(10, 2)
  status            PaymentStatus  @default(REFUND_PENDING)
  reason            String?        @db.Text
  providerRefundId  String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  return            Return?        @relation(fields: [returnId], references: [id], onDelete: SetNull)
  payment           Payment?       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Coupon {
  id                   String    @id @default(uuid())
  code                 String    @unique
  discountType         String
  discountValue        Decimal   @db.Decimal(10, 2)
  minOrderAmount       Decimal?  @db.Decimal(10, 2)
  maxUses              Int?
  usagePerCustomer     Int?
  usedCount            Int       @default(0)
  categoryRestrictions String?   @db.Text // JSON array of category IDs
  productRestrictions  String?   @db.Text // JSON array of product IDs
  excludedProducts     String?   @db.Text // JSON array of excluded IDs
  validFrom            DateTime?
  validUntil           DateTime?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())

  usages CouponUsage[]
  rules  CouponRule[]
}

model CouponRule {
  id           String   @id @default(uuid())
  couponId     String
  type         String   // "BOGO", "PERCENTAGE", "FIXED", "FREE_SHIPPING"
  value        Decimal? @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  
  coupon       Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  conditions   CouponCondition[]
}

model CouponCondition {
  id           String   @id @default(uuid())
  ruleId       String
  field        String   // "MIN_AMOUNT", "CATEGORY", "BRAND", "NEW_USER"
  operator     String   // "EQUALS", "GREATER_THAN", "IN"
  value        String   @db.Text
  createdAt    DateTime @default(now())

  rule         CouponRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  orderId   String
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String         @id @default(uuid())
  orderId           String         @unique
  amount            Decimal        @db.Decimal(10, 2)
  currency          String         @default("USD")
  paymentMethodCode String
  provider          String
  providerPaymentId String?
  providerOrderId   String?
  status            PaymentStatus  @default(PENDING)
  failureReason     String?        @db.Text
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attempts          PaymentAttempt[]
  webhooks          PaymentWebhook[]
  audits            PaymentAudit[]
  events            PaymentEvent[]
  refunds           Refund[]
}

model PaymentMethod {
  id           String              @id @default(uuid())
  code         String              @unique // UPI, CARD, COD
  name         String
  type         PaymentMethodType
  description  String?
  isActive     Boolean             @default(true)
  displayOrder Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  providers    PaymentMethodProvider[]
  rules        PaymentMethodRule[]
}

model PaymentProvider {
  id           String              @id @default(uuid())
  code         String              @unique // RAZORPAY, STRIPE, INTERNAL
  name         String
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  methods      PaymentMethodProvider[]
  configs      PaymentProviderConfig[]
}

model PaymentMethodProvider {
  id              String          @id @default(uuid())
  paymentMethodId String
  providerId      String
  priority        Int             @default(0)
  enabled         Boolean         @default(true)
  config          String?         @db.Text // JSON
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  method          PaymentMethod   @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  provider        PaymentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([paymentMethodId, providerId])
}

model PaymentProviderConfig {
  id              String          @id @default(uuid())
  providerId      String
  environment     String          @default("SANDBOX") // SANDBOX, PRODUCTION
  key             String?
  encryptedSecret String?
  webhookSecret   String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  provider        PaymentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  
  @@unique([providerId, environment])
}

model PaymentMethodRule {
  id                String          @id @default(uuid())
  paymentMethodId   String
  minAmount         Decimal?        @db.Decimal(10, 2)
  maxAmount         Decimal?        @db.Decimal(10, 2)
  allowedPincodes   String?         @db.Text // JSON Array
  blockedPincodes   String?         @db.Text // JSON Array
  allowedCategories String?         @db.Text // JSON Array
  blockedCategories String?         @db.Text // JSON Array
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  method            PaymentMethod   @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
}

model PaymentEvent {
  id                String             @id @default(uuid())
  paymentId         String
  status            PaymentEventStatus
  providerPaymentId String?
  rawPayload        String?            @db.Text
  errorMessage      String?            @db.Text
  createdAt         DateTime           @default(now())

  payment           Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}



model PaymentAttempt {
  id                String         @id @default(uuid())
  paymentId         String
  providerPaymentId String?
  status            PaymentStatus
  errorMessage      String?        @db.Text
  createdAt         DateTime       @default(now())

  payment           Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model PaymentWebhook {
  id                String   @id @default(uuid())
  paymentId         String?
  provider          String
  eventId           String   @unique
  eventType         String
  rawPayload        String   @db.Text
  signature         String?
  processed         Boolean  @default(false)
  receivedAt        DateTime @default(now())

  payment           Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
}

model PaymentAudit {
  id               String         @id @default(uuid())
  paymentId        String
  action           String
  previousStatus   PaymentStatus?
  newStatus        PaymentStatus
  providerResponse String?        @db.Text
  createdAt        DateTime       @default(now())

  payment          Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model TaxRule {
  id          String   @id @default(uuid())
  name        String
  rate        Decimal  @db.Decimal(5, 2) // e.g., 18.00 for GST
  country     String?
  state       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

