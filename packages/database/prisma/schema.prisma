// ============================================================================
// 8. DYNAMIC CMS / WEBSITE ENGINE
// ============================================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  websites Website[]
}

model Website {
  id             String   @id @default(uuid())
  domain         String   @unique
  name           String
  isActive       Boolean  @default(true)
  organizationId String?
  activeVersionId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  settings       WebsiteSettings?
  aiConfig       WebsiteAIConfig?
  themes         WebsiteTheme[]
  drafts         WebsiteDraft[]
  versions       WebsiteVersion[]
  navigations    WebsiteNavigation[]
  scripts        ScriptInjection[]
  mediaRefs      MediaReference[]
}

model WebsiteSettings {
  id                String   @id @default(uuid())
  websiteId         String   @unique
  brandName         String
  websiteName       String
  logoUrl           String?
  faviconUrl        String?
  tagline           String?
  contactEmail      String?
  contactPhone      String?
  businessAddress   String?  @db.Text
  defaultCurrency   String   @default("INR")
  defaultLanguage   String   @default("en")
  searchPlaceholder String   @default("Search products...")
  copyright         String?
  socialLinksJson   String?  @db.Text
  supportEmail      String?
  supportPhone      String?
  announcementsJson     String?  @db.Text   // JSON string[] — rotating top banner messages
  trendingSearchesJson  String?  @db.Text   // JSON string[] — search autocomplete suggestions
  paymentBadgesJson     String?  @db.Text   // JSON string[] — e.g. ["VISA","MC","UPI"]
  megaMenuFeaturedJson  String?  @db.Text   // JSON object for mega menu featured card
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

model WebsiteDraft {
  id        String   @id @default(uuid())
  websiteId String
  name      String
  version   String   @default("1.0.0")
  status    String   @default("DRAFT") // "DRAFT" | "READY"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

model WebsiteVersion {
  id           String   @id @default(uuid())
  websiteId    String
  versionLabel String
  payload      String   @db.Text // JSON of compiled runtime manifest
  hash         String?
  isLive       Boolean  @default(false)
  publishedAt  DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

model WebsiteTheme {
  id        String   @id @default(uuid())
  websiteId String
  name      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  website Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  tokens  ThemeToken[]
  layouts WebsiteLayout[]
}

model ThemeToken {
  id        String   @id @default(uuid())
  themeId   String
  key       String   // e.g. "color.primary", "font.heading"
  value     String   // e.g. "#FF5733", "Inter"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  theme WebsiteTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, key])
}

model WebsiteLayout {
  id        String   @id @default(uuid())
  themeId   String
  name      String // "Default Layout", "Checkout Layout"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  theme WebsiteTheme  @relation(fields: [themeId], references: [id], onDelete: Cascade)
  pages WebsitePage[]
}

model WebsitePage {
  id          String   @id @default(uuid())
  layoutId    String
  title       String
  slug        String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  layout   WebsiteLayout    @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  seo      Seo?
  routes   PageRoute[]
  sections WebsiteSection[]
}

model PageRoute {
  id        String   @id @default(uuid())
  pageId    String
  routePath String   // e.g. "/" or "/about"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page WebsitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, routePath])
}

model Seo {
  id          String  @id @default(uuid())
  pageId      String  @unique
  title       String?
  description String? @db.Text
  canonical   String?
  robots      String? @default("index, follow")
  schemaJson  String? @db.Text // Structured data
  twitterCard String? @default("summary_large_image")
  ogImageId   String?
  faviconId   String?

  page    WebsitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  ogImage Media?      @relation("SeoOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  favicon Media?      @relation("SeoFavicon", fields: [faviconId], references: [id], onDelete: SetNull)
}

model ComponentRegistry {
  id        String   @id @default(uuid())
  name      String   @unique // "HeroBanner", "ProductCarousel"
  schema    String   @db.Text // Valid property schema
  version   String   @default("1.0.0")
  createdAt DateTime @default(now())

  components WebsiteComponent[]
}

model WebsiteSection {
  id        String @id @default(uuid())
  pageId    String
  name      String
  sortOrder Int    @default(0)

  page       WebsitePage        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  components WebsiteComponent[]
}

model WebsiteComponent {
  id         String @id @default(uuid())
  sectionId  String
  registryId String
  sortOrder  Int    @default(0)

  section    WebsiteSection             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  registry   ComponentRegistry          @relation(fields: [registryId], references: [id], onDelete: Restrict)
  properties WebsiteComponentProperty[]
}

model WebsiteComponentProperty {
  id           String  @id @default(uuid())
  componentId  String
  key          String // "headline", "collectionId"
  bindingType  String  @default("LITERAL") // "LITERAL", "ENTITY", "EXPRESSION"
  literalValue String? @db.Text
  entityType   String? // "Collection", "Product"
  entityId     String?
  expression   String? // "user.firstName"
  schemaType   String  @default("string")

  component WebsiteComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([componentId, key])
}

model WebsiteNavigation {
  id        String @id @default(uuid())
  websiteId String
  handle    String @unique
  name      String // "Main Header"
  type      String @default("HEADER") // "HEADER" | "FOOTER" | "MOBILE" | "SIDEBAR"

  website Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  menus   WebsiteMenu[]
}

model WebsiteMenu {
  id           String  @id @default(uuid())
  navigationId String
  label        String
  url          String
  parentId     String?
  sortOrder    Int     @default(0)

  navigation WebsiteNavigation @relation(fields: [navigationId], references: [id], onDelete: Cascade)
  parent     WebsiteMenu?      @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   WebsiteMenu[]     @relation("MenuHierarchy")
}

model WebsiteAIConfig {
  id                   String   @id @default(uuid())
  websiteId            String   @unique
  assistantName        String   @default("AI Assistant")
  avatarUrl            String?
  greeting             String   @default("Hi! How can I help you today?")
  suggestionsJson      String?  @db.Text // JSON string of suggested queries
  prompt               String?  @db.Text
  model                String   @default("gemini-2.5-flash")
  temperature          Float    @default(0.7)
  tone                 String   @default("professional")
  enableSearch         Boolean  @default(true)
  enableCompare        Boolean  @default(true)
  enableRecommendations Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

model ScriptInjection {
  id        String   @id @default(uuid())
  websiteId String
  name      String
  placement String   // "HEAD" | "BODY"
  code      String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

model MediaReference {
  id        String   @id @default(uuid())
  websiteId String
  mediaId   String
  createdAt DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

model WebsiteBanner {
  id        String  @id @default(uuid())
  mediaId   String
  name      String
  linkUrl   String?
  position  String // "HOME_TOP"
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  media Media @relation(fields: [mediaId], references: [id], onDelete: Restrict)
}

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  SEARCH
  ADD_TO_CART
  REMOVE_FROM_CART
  CHECKOUT
  PAYMENT
  PURCHASE
  LOGIN
  REGISTER
  LOGOUT
  REFUND
  RETURN
  NOTIFICATION_OPEN
  MEDIA_VIEW
}

model AnalyticsEvent {
  id             String             @id @default(uuid())
  organizationId String?
  websiteId      String?
  userId         String?
  sessionId      String?
  event          AnalyticsEventType
  category       String?
  entityType     String?
  entityId       String?
  properties     String?            @db.Text
  ipAddress      String?
  country        String?
  city           String?
  device         String?
  browser        String?
  platform       String?
  referrer       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  createdAt      DateTime           @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([event])
}

model AnalyticsSession {
  id          String    @id @default(uuid())
  userId      String?
  visitorId   String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  pageViews   Int       @default(1)
  duration    Int       @default(0)
  device      String?
  browser     String?
  os          String?
  country     String?
  city        String?
  entryPage   String?
  exitPage    String?
  createdAt   DateTime  @default(now())

  @@index([visitorId])
  @@index([userId])
}

model AnalyticsPageView {
  id        String   @id @default(uuid())
  sessionId String
  page      String
  title     String?
  duration  Int      @default(0)
  referrer  String?
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model AnalyticsHeatmap {
  id         String   @id @default(uuid())
  page       String
  x          Int
  y          Int
  clickCount Int      @default(1)
  createdAt  DateTime @default(now())

  @@index([page])
}

model CustomerAnalytics {
  id                    String    @id @default(uuid())
  userId                String    @unique
  organizationId        String?
  websiteId             String?
  totalOrders           Int       @default(0)
  totalRevenue          Float     @default(0.0)
  averageOrderValue     Float     @default(0.0)
  lifetimeValue         Float     @default(0.0)
  firstPurchaseAt       DateTime?
  lastPurchaseAt        DateTime?
  daysSinceLastPurchase Int       @default(0)
  refundCount           Int       @default(0)
  wishlistCount         Int       @default(0)
  reviewCount           Int       @default(0)
  favoriteCategory      String?
  favoriteBrand         String?
  customerSegment       String    @default("NEW")
  predictedChurnScore   Float     @default(0.0)
  predictedLtv          Float     @default(0.0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model CampaignMetrics {
  id             String   @id @default(uuid())
  campaign       String   @unique
  sessions       Int      @default(0)
  orders         Int      @default(0)
  revenue        Float    @default(0.0)
  conversionRate Float    @default(0.0)
  cost           Float    @default(0.0)
  roas           Float    @default(0.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FeatureUsageMetrics {
  id         String   @id @default(uuid())
  feature    String   @unique
  count      Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model AnalyticsProductMetrics {
  id             String   @id @default(uuid())
  productId      String
  date           DateTime
  views          Int      @default(0)
  wishlistAdds   Int      @default(0)
  cartAdds       Int      @default(0)
  purchases      Int      @default(0)
  returns        Int      @default(0)
  revenue        Float    @default(0.0)
  conversionRate Float    @default(0.0)

  embeddingReady Boolean  @default(false)
  summaryReady   Boolean  @default(false)
  anomalyScore   Float    @default(0.0)
  forecastReady  Boolean  @default(false)

  createdAt      DateTime @default(now())

  @@unique([productId, date])
}

model AnalyticsCategoryMetrics {
  id             String   @id @default(uuid())
  categoryId     String
  date           DateTime
  views          Int      @default(0)
  revenue        Float    @default(0.0)
  orders         Int      @default(0)
  conversionRate Float    @default(0.0)
  createdAt      DateTime @default(now())

  @@unique([categoryId, date])
}

model AnalyticsSalesMetrics {
  id         String   @id @default(uuid())
  date       DateTime @unique
  orders     Int      @default(0)
  customers  Int      @default(0)
  revenue    Float    @default(0.0)
  refunds    Float    @default(0.0)
  aov        Float    @default(0.0)
  netRevenue Float    @default(0.0)
  createdAt  DateTime @default(now())
}

model AnalyticsTrafficMetrics {
  id             String   @id @default(uuid())
  date           DateTime @unique
  sessions       Int      @default(0)
  users          Int      @default(0)
  bounceRate     Float    @default(0.0)
  avgDuration    Int      @default(0)
  newUsers       Int      @default(0)
  returningUsers Int      @default(0)
  createdAt      DateTime @default(now())
}

model AnalyticsSearchMetrics {
  id             String   @id @default(uuid())
  query          String   @unique
  count          Int      @default(0)
  resultsClicked Int      @default(0)
  conversionRate Float    @default(0.0)
  createdAt      DateTime @default(now())
}

model AnalyticsFunnel {
  id             String                @id @default(uuid())
  name           String
  createdAt      DateTime              @default(now())
  steps          AnalyticsFunnelStep[]
}

model AnalyticsFunnelStep {
  id       String          @id @default(uuid())
  funnelId String
  name     String
  event    String
  sortOrder Int             @default(0)
  funnel   AnalyticsFunnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)
}

model Dashboard {
  id        String            @id @default(uuid())
  name      String
  isDefault Boolean           @default(false)
  createdAt DateTime          @default(now())
  widgets   DashboardWidget[]
}

model DashboardWidget {
  id          String           @id @default(uuid())
  dashboardId String
  title       String
  type        String
  metric      String
  width       Int              @default(6)
  height      Int              @default(4)
  sortOrder   Int              @default(0)
  dashboard   Dashboard        @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  layouts     DashboardLayout[]
}

model DashboardLayout {
  id       String          @id @default(uuid())
  widgetId String
  userId   String
  x        Int
  y        Int
  w        Int
  h        Int
  widget   DashboardWidget @relation(fields: [widgetId], references: [id], onDelete: Cascade)
}

model ForecastDataset {
  id          String   @id @default(uuid())
  metric      String
  date        DateTime
  value       Float
  granularity String   @default("DAILY")
  createdAt   DateTime @default(now())
}

model AlertRule {
  id        String   @id @default(uuid())
  metric    String
  operator  String
  threshold Float
  severity  String   @default("WARNING")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ScheduledReport {
  id         String   @id @default(uuid())
  name       String
  frequency  String
  recipients String
  format     String   @default("PDF")
  timezone   String   @default("UTC")
  lastSentAt DateTime?
  createdAt  DateTime @default(now())
}

model AnalyticsDashboardCache {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AIProvider {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  models    AIModel[]
}

model AIModel {
  id             String     @id @default(uuid())
  providerId     String
  code           String     @unique
  name           String
  inputCostRate  Float      @default(0.0)
  outputCostRate Float      @default(0.0)
  contextWindow  Int        @default(4096)
  createdAt      DateTime   @default(now())
  provider       AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model AIConfiguration {
  id              String   @id @default(uuid())
  organizationId  String?
  websiteId       String?
  defaultProvider String   @default("MOCK")
  defaultModel    String   @default("mock-model")
  temperature     Float    @default(0.7)
  maxTokens       Int      @default(2048)
  enabledFeatures String   @db.Text
  monthlyBudget   Float    @default(100.0)
  dailyBudget     Float    @default(5.0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AIConversation {
  id        String      @id @default(uuid())
  userId    String?
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AIMessage[]
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String
  content        String         @db.Text
  tokens         Int            @default(0)
  latencyMs      Int            @default(0)
  cost           Float          @default(0.0)
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model AIJob {
  id        String   @id @default(uuid())
  type      String
  status    String   @default("PENDING")
  payload   String?  @db.Text
  result    String?  @db.Text
  error     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIUsage {
  id               String   @id @default(uuid())
  organizationId   String?
  websiteId        String?
  feature          String
  provider         String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  cost             Float    @default(0.0)
  latencyMs        Int      @default(0)
  createdAt        DateTime @default(now())
}

model AIPromptTemplate {
  id                String   @id @default(uuid())
  name              String   @unique
  systemInstruction String   @db.Text
  userPromptSchema  String   @db.Text
  variables         String   @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AIEmbedding {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  vector     String   @db.Text
  createdAt  DateTime @default(now())

  @@unique([entityType, entityId])
}

// ============================================================================
// Sprint 13 - Regional Localization & Config models
// ============================================================================

model Country {
  code            String                @id // e.g. "IN", "US"
  name            String
  currency        String
  currencySymbol  String
  locale          String
  phonePrefix     String
  phoneLength     Int
  isActive        Boolean               @default(true)
  
  states          State[]
  paymentOptions  PaymentAvailability[]
  regions         RegionalConfiguration[]
  warehouses      Warehouse[]
  bankOffers      BankOffer[]
  holidays        HolidayCalendar[]
}

model State {
  id               String       @id @default(uuid())
  countryCode      String
  code             String       // e.g. "KA" for Karnataka
  name             String
  isUnionTerritory Boolean      @default(false)
  
  country          Country      @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  districts        District[]
  pincodes         Pincode[]
  shippingZones    ShippingZoneState[]
}

model District {
  id      String   @id @default(uuid())
  stateId String
  name    String
  
  state   State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  cities  City[]
}

model City {
  id         String    @id @default(uuid())
  districtId String
  name       String
  
  district   District  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  pincodes   Pincode[]
}

model Pincode {
  code            String   @id // 6 digits for India
  cityId          String?
  stateId         String?
  isServiced      Boolean  @default(true)
  isCOD           Boolean  @default(true)
  isExpress       Boolean  @default(false)
  estDaysMin      Int      @default(1)
  estDaysMax      Int      @default(3)
  shippingCharge  Decimal  @db.Decimal(10, 2) @default(0.00)

  city            City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  state           State?   @relation(fields: [stateId], references: [id], onDelete: SetNull)
}

model GSTRule {
  id       String  @id @default(uuid())
  hsnCode  String  @unique
  cgst     Decimal @db.Decimal(5, 2)
  sgst     Decimal @db.Decimal(5, 2)
  igst     Decimal @db.Decimal(5, 2)
  utgst    Decimal @db.Decimal(5, 2)
}

model ExchangeProgram {
  id            String         @id @default(uuid())
  name          String
  isActive      Boolean        @default(true)
  rules         ExchangeRule[]
}

model DeviceCategory {
  id          String         @id @default(uuid())
  name        String         // e.g. "Smartphones"
  rules       ExchangeRule[]
}

model ExchangeRule {
  id                String          @id @default(uuid())
  exchangeProgramId String
  deviceCategoryId  String
  brand             String
  modelName         String
  maxValuation      Decimal         @db.Decimal(10, 2)
  conditionsJson    String          @db.Text // JSON value rules based on condition grade

  program           ExchangeProgram @relation(fields: [exchangeProgramId], references: [id], onDelete: Cascade)
  category          DeviceCategory  @relation(fields: [deviceCategoryId], references: [id], onDelete: Cascade)
}

model Warehouse {
  id          String      @id @default(uuid())
  name        String
  countryCode String
  state       String
  city        String
  pincode     String
  isActive    Boolean     @default(true)

  country     Country     @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  inventory   Inventory[] @relation("WarehouseInventory")
}

model ShippingSLA {
  id            String   @id @default(uuid())
  sourceState   String
  destState     String
  transitDays   Int
  cutoffHour    Int      @default(14) // 2 PM cutoff for same-day packing
}

model HolidayCalendar {
  id          String   @id @default(uuid())
  countryCode String
  date        DateTime
  name        String

  country     Country  @relation(fields: [countryCode], references: [code], onDelete: Cascade)
}

model FestivalCampaign {
  id                String               @id @default(uuid())
  code              String               @unique // e.g. "DIWALI_2026"
  name              String
  startDate         DateTime
  endDate           DateTime
  themeJson         String?              @db.Text // Theme variables mapping
  isActive          Boolean              @default(true)

  banners           FestivalBanner[]
  homepageLayouts   FestivalLayout[]
  coupons           FestivalCoupon[]
  collections       FestivalCollection[]
}

model FestivalBanner {
  id                 String           @id @default(uuid())
  festivalCampaignId String
  imageUrl           String
  targetUrl          String
  position           String

  campaign           FestivalCampaign @relation(fields: [festivalCampaignId], references: [id], onDelete: Cascade)
}

model FestivalLayout {
  id                 String           @id @default(uuid())
  festivalCampaignId String
  sectionName        String
  sortOrder          Int
  configJson         String           @db.Text

  campaign           FestivalCampaign @relation(fields: [festivalCampaignId], references: [id], onDelete: Cascade)
}

model FestivalCoupon {
  id                 String           @id @default(uuid())
  festivalCampaignId String
  code               String
  discountPercent    Decimal          @db.Decimal(5, 2)

  campaign           FestivalCampaign @relation(fields: [festivalCampaignId], references: [id], onDelete: Cascade)
}

model FestivalCollection {
  id                 String           @id @default(uuid())
  festivalCampaignId String
  collectionId       String

  campaign           FestivalCampaign @relation(fields: [festivalCampaignId], references: [id], onDelete: Cascade)
}

model BankOffer {
  id             String    @id @default(uuid())
  countryCode    String
  bankName       String    // e.g. "HDFC"
  cardType       String    // "CREDIT", "DEBIT", "ANY"
  minTxnAmount   Decimal   @db.Decimal(10, 2)
  discountType   String    // "PERCENT", "FIXED"
  discountValue  Decimal   @db.Decimal(10, 2)
  maxDiscount    Decimal   @db.Decimal(10, 2)
  isActive       Boolean   @default(true)

  country        Country   @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  emiPlans       EMIPlan[]
}

model EMIPlan {
  id             String    @id @default(uuid())
  bankOfferId    String
  months         Int
  interestRate   Decimal   @db.Decimal(5, 2) // e.g. 14.00
  isNoCost       Boolean   @default(false)
  minAmount      Decimal   @db.Decimal(10, 2)

  bankOffer      BankOffer @relation(fields: [bankOfferId], references: [id], onDelete: Cascade)
}

model PaymentAvailability {
  id             String   @id @default(uuid())
  countryCode    String
  method         String   // "COD", "UPI", "RAZORPAY"
  minAmount      Decimal? @db.Decimal(10, 2)
  maxAmount      Decimal? @db.Decimal(10, 2)
  isActive       Boolean  @default(true)

  country        Country  @relation(fields: [countryCode], references: [code], onDelete: Cascade)
}

model RegionalConfiguration {
  id                String  @id @default(uuid())
  countryCode       String  @unique
  defaultLanguage   String  @default("en")
  taxType           String  @default("GST") // "GST", "VAT", "SALES_TAX"
  addressFieldsJson String  @db.Text // JSON fields definition

  country           Country @relation(fields: [countryCode], references: [code], onDelete: Cascade)
}

model ShippingZoneState {
  id             String       @id @default(uuid())
  shippingZoneId String
  stateId        String

  zone           ShippingZone @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade)
  state          State        @relation(fields: [stateId], references: [id], onDelete: Cascade)
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  rolloutPct  Int      @default(100)
  rulesJson   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key, enabled])
}



