generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. GLOBAL MEDIA LIBRARY
// ============================================================================

model Media {
  id              String   @id @default(uuid())
  filename        String
  originalName    String
  mimeType        String
  size            Int      // bytes
  width           Int?
  height          Int?
  storageProvider String   // "LOCAL", "AWS_S3", "CLOUDINARY"
  path            String   @unique
  alt             String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  productImages   ProductImage[]
  banners         WebsiteBanner[]
  categories      Category[]
  brands          Brand[]
  seoOgImages     Seo[]    @relation("SeoOgImage")
  seoFavicons     Seo[]    @relation("SeoFavicon")
}

// ============================================================================
// 2. USER & AUTHENTICATION
// ============================================================================

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String
  firstName        String
  lastName         String
  role             Role         @default(CUSTOMER)
  isActive         Boolean      @default(true)
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  addresses        Address[]
  orders           Order[]
  cart             Cart?
  wishlist         Wishlist?
  reviews          Review[]
  notifications    NotificationRecipient[]
  recentlyViewed   RecentlyViewed[]
  searchHistory    SearchHistory[]
  couponUsages     CouponUsage[]
  sessions         UserSession[]
  authTokens       AuthToken[]
}

enum Role {
  CUSTOMER
  ADMIN
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model AuthToken {
  id           String   @id @default(uuid())
  userId       String
  type         String   // "EMAIL_VERIFICATION", "PASSWORD_RESET", "OTP"
  token        String   @unique
  expiresAt    DateTime
  isUsed       Boolean  @default(false)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  label       String?  // "Home", "Work"
  street      String
  city        String
  state       String
  postalCode  String
  country     String
  isBilling   Boolean  @default(false)
  isShipping  Boolean  @default(true)
  isDefault   Boolean  @default(false)
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

// ============================================================================
// 3. PRODUCT & CATALOG DOMAIN
// ============================================================================

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  mediaId     String?
  parentId    String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  media       Media?     @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  @@index([parentId])
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  mediaId     String?
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  media       Media?    @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  products    Product[]
}

model Collection {
  id          String              @id @default(uuid())
  name        String
  slug        String              @unique
  description String?             @db.Text
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  products    CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([collectionId, productId])
}

model Product {
  id              String     @id @default(uuid())
  brandId         String?
  categoryId      String
  name            String
  slug            String     @unique
  description     String     @db.LongText
  mrp             Decimal    @db.Decimal(10, 2)
  sellingPrice    Decimal    @db.Decimal(10, 2)
  costPrice       Decimal?   @db.Decimal(10, 2)
  taxRate         Decimal    @default(0.00) @db.Decimal(5, 2)
  discount        Decimal    @default(0.00) @db.Decimal(10, 2)
  currency        String     @default("USD")
  priceEffectiveFrom DateTime?
  priceEffectiveTo   DateTime?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  brand             Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category          Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants          ProductVariant[]
  images            ProductImage[]
  reviews           Review[]
  collections       CollectionProduct[]
  productAttributes ProductAttribute[]
  specifications    ProductSpecification[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, deletedAt])
}

model ProductImage {
  id          String   @id @default(uuid())
  productId   String
  mediaId     String
  isPrimary   Boolean  @default(false)
  sortOrder   Int      @default(0)
  type        String?  // "thumbnail", "gallery", "hero"
  createdAt   DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  @@index([productId])
}

// ============================================================================
// 4. ATTRIBUTES, SPECIFICATIONS & FILTERING
// ============================================================================

model Attribute {
  id          String           @id @default(uuid())
  name        String           @unique
  type        String           @default("text") // "color_hex", "text", "dropdown"
  isFilterable Boolean         @default(true)
  createdAt   DateTime         @default(now())
  
  values      AttributeValue[]
  products    ProductAttribute[]
}

model AttributeValue {
  id          String             @id @default(uuid())
  attributeId String
  value       String
  meta        String?            // "#FF0000"
  sortOrder   Int                @default(0)
  
  attribute   Attribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants    VariantAttribute[]
}

model ProductAttribute {
  productId   String
  attributeId String

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  @@id([productId, attributeId])
}

model ProductVariant {
  id          String    @id @default(uuid())
  productId   String
  sku         String    @unique
  name        String
  priceOffset Decimal   @default(0.00) @db.Decimal(10, 2)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory   Inventory?
  attributes  VariantAttribute[]
  orderItems  OrderItem[]
  cartItems   CartItem[]
}

model VariantAttribute {
  variantId        String
  attributeValueId String

  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  @@id([variantId, attributeValueId])
}

model SpecificationGroup {
  id          String   @id @default(uuid())
  name        String   // "Display", "Battery"
  createdAt   DateTime @default(now())
  
  specs       Specification[]
}

model Specification {
  id          String   @id @default(uuid())
  groupId     String
  name        String   // "Resolution", "Capacity"
  createdAt   DateTime @default(now())

  group       SpecificationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  productSpecs ProductSpecification[]
}

model ProductSpecification {
  productId   String
  specId      String
  value       String   // "1080p", "5000mAh"
  
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  spec        Specification @relation(fields: [specId], references: [id], onDelete: Cascade)
  @@id([productId, specId])
}

// ============================================================================
// 5. INVENTORY DOMAIN
// ============================================================================

model Inventory {
  id               String              @id @default(uuid())
  variantId        String              @unique
  quantityAvailable Int                @default(0)
  quantityReserved  Int                @default(0)
  status           String              @default("IN_STOCK")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  variant          ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements        InventoryMovement[]
}

model InventoryMovement {
  id          String    @id @default(uuid())
  inventoryId String
  quantity    Int       
  type        String    // "PURCHASE", "SALE", "RETURN", "RESERVATION", "ADJUSTMENT"
  referenceId String?   
  notes       String?
  createdAt   DateTime  @default(now())

  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  @@index([inventoryId])
}

// ============================================================================
// 6. CHECKOUT: CART, ORDERS, SHIPPING & RETURNS
// ============================================================================

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  @@unique([cartId, variantId])
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id        String   @id @default(uuid())
  wishlistId String
  productId String
  createdAt DateTime @default(now())

  wishlist  Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  @@unique([wishlistId, productId])
}

model ShippingZone {
  id          String   @id @default(uuid())
  name        String   
  countries   String   @db.LongText // JSON ["US", "CA"]
  isActive    Boolean  @default(true)
  
  rates       ShippingRate[]
}

model ShippingRate {
  id          String   @id @default(uuid())
  zoneId      String
  methodName  String   // "Express"
  cost        Decimal  @db.Decimal(10,2)
  minOrder    Decimal? @db.Decimal(10,2)
  maxOrder    Decimal? @db.Decimal(10,2)
  estDays     String   // "3-5 Business Days"
  isActive    Boolean  @default(true)
  
  zone        ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique 
  userId        String
  subTotal      Decimal     @db.Decimal(10, 2)
  discountTotal Decimal     @default(0.00) @db.Decimal(10, 2)
  taxTotal      Decimal     @default(0.00) @db.Decimal(10, 2)
  shippingTotal Decimal     @default(0.00) @db.Decimal(10, 2)
  grandTotal    Decimal     @db.Decimal(10, 2)
  status        String      @default("PENDING")
  shippingAddr  String      @db.Text 
  billingAddr   String      @db.Text 
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  transactions  PaymentTransaction[]
  returns       Return[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id            String         @id @default(uuid())
  orderId       String
  variantId     String?        
  productName   String         
  brandName     String?        
  sku           String         
  quantity      Int
  unitPrice     Decimal        @db.Decimal(10, 2) 
  discount      Decimal        @default(0.00) @db.Decimal(10, 2) 
  tax           Decimal        @default(0.00) @db.Decimal(10, 2) 
  totalPrice    Decimal        @db.Decimal(10, 2) 
  createdAt     DateTime       @default(now())

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  @@index([orderId])
}

model Return {
  id          String   @id @default(uuid())
  orderId     String
  reason      String
  status      String   @default("REQUESTED") // "REQUESTED", "APPROVED", "REFUNDED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items       ReturnItem[]
  refund      Refund?
}

model ReturnItem {
  id          String   @id @default(uuid())
  returnId    String
  orderItemId String
  quantity    Int
  
  return      Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

model Refund {
  id          String   @id @default(uuid())
  returnId    String   @unique
  amount      Decimal  @db.Decimal(10, 2)
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  return      Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

model Coupon {
  id                  String        @id @default(uuid())
  code                String        @unique
  discountType        String        
  discountValue       Decimal       @db.Decimal(10,2)
  minOrderAmount      Decimal?      @db.Decimal(10,2)
  maxUses             Int?
  usagePerCustomer    Int?
  usedCount           Int           @default(0)
  categoryRestrictions String?      @db.LongText // JSON array of category IDs
  productRestrictions  String?      @db.LongText // JSON array of product IDs
  excludedProducts     String?      @db.LongText // JSON array of excluded IDs
  validFrom           DateTime?
  validUntil          DateTime?
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())

  usages              CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  orderId   String
  createdAt DateTime @default(now())

  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentMethod {
  id          String   @id @default(uuid())
  name        String   
  provider    String   
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  transactions PaymentTransaction[]
}

model PaymentTransaction {
  id              String        @id @default(uuid())
  orderId         String
  paymentMethodId String
  transactionId   String?       
  amount          Decimal       @db.Decimal(10, 2)
  status          String        @default("PENDING") 
  rawResponse     String?       @db.LongText
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
}

// ============================================================================
// 7. REVIEWS, AUDITS, ANALYTICS & SETTINGS
// ============================================================================

model Review {
  id        String   @id @default(uuid())
  productId String
  userId    String
  rating    Int      // 1 to 5
  title     String?
  comment   String?  @db.Text
  isVerified Boolean @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  body      String   @db.Text
  type      String   // e.g., "PROMO", "SYSTEM", "ORDER_UPDATE"
  createdAt DateTime @default(now())
  
  recipients NotificationRecipient[]
}

model NotificationRecipient {
  notificationId String
  userId         String
  isRead         Boolean @default(false)
  readAt         DateTime?
  
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([notificationId, userId])
}

model SearchHistory {
  id        String   @id @default(uuid())
  userId    String?
  query     String
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([query])
}

model PopularSearch {
  id         String   @id @default(uuid())
  query      String   @unique
  searchCount Int     @default(1)
  updatedAt  DateTime @updatedAt
}

model RecentlyViewed {
  id        String   @id @default(uuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, productId])
}

model Setting {
  key         String   @id
  value       String   @db.Text
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String   // "CREATE", "UPDATE", "DELETE"
  changes    String   @db.LongText // JSON payload of changes
  userId     String?  // The admin/user who made the change
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String   // "PAGE_VIEW", "PRODUCT_VIEW", "SEARCH", "CLICK", "CONVERSION"
  entityId  String?  // ProductId, PageId, etc.
  userId    String?
  sessionId String?
  metadata  String?  @db.LongText // JSON payload
  createdAt DateTime @default(now())
  @@index([eventType, entityId])
}

// ============================================================================
// 8. DYNAMIC CMS / WEBSITE ENGINE
// ============================================================================

model Website {
  id          String   @id @default(uuid())
  domain      String   @unique
  name        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  themes      WebsiteTheme[]
  drafts      WebsiteDraft[]
  versions    WebsiteVersion[]
}

model WebsiteDraft {
  id           String   @id @default(uuid())
  websiteId    String
  name         String
  payload      String   @db.LongText // JSON representation of full draft state
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  website      Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

model WebsiteVersion {
  id           String   @id @default(uuid())
  websiteId    String
  versionLabel String
  payload      String   @db.LongText // JSON of published state
  isLive       Boolean  @default(false)
  publishedAt  DateTime @default(now())
  
  website      Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

model WebsiteTheme {
  id          String   @id @default(uuid())
  websiteId   String
  name        String
  config      String   @db.LongText // Global fonts, colors, spacing
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())

  website     Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  layouts     WebsiteLayout[]
}

model WebsiteLayout {
  id           String   @id @default(uuid())
  themeId      String
  name         String   // "Default Layout", "Checkout Layout"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  theme        WebsiteTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)
  pages        WebsitePage[]
}

model WebsitePage {
  id          String   @id @default(uuid())
  layoutId    String
  title       String
  slug        String   
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  layout      WebsiteLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  seo         Seo?
  sections    WebsiteSection[]
}

model Seo {
  id          String   @id @default(uuid())
  pageId      String   @unique
  title       String?
  description String?  @db.Text
  canonical   String?
  robots      String?  @default("index, follow")
  schemaJson  String?  @db.LongText // Structured data
  twitterCard String?  @default("summary_large_image")
  ogImageId   String?
  faviconId   String?
  
  page        WebsitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  ogImage     Media?      @relation("SeoOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  favicon     Media?      @relation("SeoFavicon", fields: [faviconId], references: [id], onDelete: SetNull)
}

model ComponentRegistry {
  id           String   @id @default(uuid())
  name         String   @unique // "HeroBanner", "ProductCarousel"
  schema       String   @db.LongText // Valid property schema
  version      String   @default("1.0.0")
  createdAt    DateTime @default(now())
  
  components   WebsiteComponent[]
}

model WebsiteSection {
  id          String   @id @default(uuid())
  pageId      String
  name        String   
  sortOrder   Int      @default(0)
  
  page        WebsitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  components  WebsiteComponent[]
}

model WebsiteComponent {
  id          String   @id @default(uuid())
  sectionId   String
  registryId  String
  sortOrder   Int      @default(0)

  section     WebsiteSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  registry    ComponentRegistry @relation(fields: [registryId], references: [id], onDelete: Restrict)
  properties  WebsiteComponentProperty[]
}

model WebsiteComponentProperty {
  id           String   @id @default(uuid())
  componentId  String
  key          String   // "headline", "collectionId"
  bindingType  String   @default("LITERAL") // "LITERAL", "ENTITY", "EXPRESSION"
  literalValue String?  @db.LongText
  entityType   String?  // "Collection", "Product"
  entityId     String?
  expression   String?  // "user.firstName"
  schemaType   String   @default("string")

  component    WebsiteComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  @@unique([componentId, key])
}

model WebsiteNavigation {
  id          String   @id @default(uuid())
  handle      String   @unique
  name        String   // "Main Header"
  
  menus       WebsiteMenu[]
}

model WebsiteMenu {
  id             String   @id @default(uuid())
  navigationId   String
  label          String
  url            String
  parentId       String?
  sortOrder      Int      @default(0)

  navigation     WebsiteNavigation @relation(fields: [navigationId], references: [id], onDelete: Cascade)
  parent         WebsiteMenu?      @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       WebsiteMenu[]     @relation("MenuHierarchy")
}

model WebsiteBanner {
  id          String   @id @default(uuid())
  mediaId     String
  name        String
  linkUrl     String?
  position    String   // "HOME_TOP"
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
}
