# EllipMart Monorepo Environment Template (.env.example)
# Use this reference to configure your production Vercel & Supabase environments.

# -----------------------------------------------------------------------------
# 1. DATABASE (Supabase PostgreSQL)
# -----------------------------------------------------------------------------
# Transaction Pooler connection string (Port 6543) - used by application runtime
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct / Session connection string (Port 5432) - used by Prisma CLI for migrations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET="your-32-character-access-secret"
JWT_REFRESH_SECRET="your-32-character-refresh-secret"

# -----------------------------------------------------------------------------
# 2.5 REDIS (Rate Limiting & Caching)
# -----------------------------------------------------------------------------
# Create a database on Upstash (https://upstash.com)
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Google OAuth (Customer Portal)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"
GOOGLE_ALLOWED_ORIGINS="http://localhost:3000"
GOOGLE_STATE_SECRET="your-random-32-char-state-secret"

# -----------------------------------------------------------------------------
# 3. SUPABASE CLIENT & STORAGE (Replaces Cloudinary)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="media"

# -----------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE (Google Gemini)
# -----------------------------------------------------------------------------
GEMINI_API_KEY="your-google-gemini-api-key"

# -----------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (Razorpay)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# -----------------------------------------------------------------------------
# 6. EMAIL PROVIDER (SMTP / Resend / Nodemailer)
# -----------------------------------------------------------------------------
SMTP_HOST="smtp.provider.com"
SMTP_PORT=587
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
EMAIL_FROM="EllipMart <noreply@ellipmart.com>"

# -----------------------------------------------------------------------------
# 7. PUBLIC CLIENT VARS (Storefront / Merchant / Admin)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STOREFRONT_URL="https://ellipmart.vercel.app"
NEXT_PUBLIC_MERCHANT_URL="https://merchant.ellipmart.vercel.app"
NEXT_PUBLIC_ADMIN_URL="https://admin.ellipmart.vercel.app"
NEXT_PUBLIC_API_URL="https://ellipmart.vercel.app/api/v1"
