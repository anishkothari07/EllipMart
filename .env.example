# SmartGO Monorepo Environment Template (.env.example)
# Use this reference to configure your production Vercel & Railway project environments.

# -----------------------------------------------------------------------------
# 1. DATABASE (Railway MySQL)
# -----------------------------------------------------------------------------
DATABASE_URL="mysql://root:password@containers-us-west-xxx.railway.app:7988/railway"

# -----------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET="your-access-secret"
JWT_REFRESH_SECRET="your-refresh-secret"

# -----------------------------------------------------------------------------
# 2.5 REDIS (Rate Limiting & Caching)
# -----------------------------------------------------------------------------
# Create a database on Upstash (https://upstash.com)
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Google OAuth (Customer Portal)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3001/api/v1/auth/google/callback"
GOOGLE_ALLOWED_ORIGINS="http://localhost:3001"
GOOGLE_STATE_SECRET="your-random-32-char-state-secret"

# -----------------------------------------------------------------------------
# 3. MEDIA STORAGE (Cloudinary)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# -----------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE (Google Gemini)
# -----------------------------------------------------------------------------
GEMINI_API_KEY="your-google-gemini-api-key"

# -----------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (Razorpay)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# -----------------------------------------------------------------------------
# 6. EMAIL PROVIDER (SMTP / Resend / Nodemailer)
# -----------------------------------------------------------------------------
SMTP_HOST="smtp.provider.com"
SMTP_PORT=587
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
EMAIL_FROM="SmartGO <noreply@smartgo.com>"

# -----------------------------------------------------------------------------
# 7. PUBLIC CLIENT VARS (Vercel Storefront / Merchant / Admin)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STOREFRONT_URL="https://smartgo.vercel.app"
NEXT_PUBLIC_MERCHANT_URL="https://merchant.smartgo.vercel.app"
NEXT_PUBLIC_ADMIN_URL="https://admin.smartgo.vercel.app"
NEXT_PUBLIC_API_URL="https://smartgo.vercel.app/api/v1"
